---
import { locales, getLocale } from '@/paraglide/runtime'
import { Icon } from 'astro-icon/components'
import { m } from '@/paraglide/messages'

const currentLang = getLocale()
const newLang = locales.find(lang => lang !== currentLang)
---

<div>
  <button
    class="btn btn-link btn-circle"
    onclick="changeLang()"
    data-current-lang={currentLang}
    data-new-lang={newLang}
    aria-label={m.langToggleDesc()}
  >
    <Icon name={currentLang === 'en' ? 'br-flag' : 'uk-flag'} />
  </button>
</div>

<style>
  button {
    border-radius: 100%;
  }
</style>

<script is:inline>
  function changeLang() {
    const { currentLang, newLang } = document.querySelector('button').dataset

    // if (currentLang === newLang) {
    //   return
    // }

    const url = new URL(window.location.href)

    // Only replace the first path segment (the locale prefix).
    // e.g. /en/projects/my-en-slug → /pt-br/projects/my-slug
    const segments = url.pathname.split('/')
    segments[1] = newLang
    url.pathname = segments.join('/')

    window.location.href = url.href
  }
</script>
